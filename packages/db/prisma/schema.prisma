generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// Multi-tenant root entity.
model Organization {
  id                   String                @id @default(cuid())
  name                 String
  legalName            String?
  industryId           String?
  country              String?
  address              String?
  logoUrl              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  aiLogs               AiLog[]
  auditLogs            AuditLog[]
  calculatedEmissions  CalculatedEmissions[]
  cargoItems           CargoItem[]
  documents            Document[]
  emissionsAggregates  EmissionsAggregate[]
  featureFlags         FeatureFlag[]
  invites              Invite[]
  notifications        Notification[]
  optimizationRuns     OptimizationRun[]
  organizationSettings OrganizationSetting?
  industry             Industry?             @relation(fields: [industryId], references: [id])
  reportingPeriods     ReportingPeriod[]
  sessions             Session[]
  shipments            Shipment[]
  sites                Site[]
  users                User[]
  vehicleTypes         VehicleType[]
  vehicles             Vehicle[]
  mlModels             MlModel[]
  brsrReports          BrsrReport[]

  @@map("organizations")
}

/// Facility / Site Entity
model Site {
  id                  String                @id @default(cuid())
  organizationId      String
  name                String
  type                SiteType
  status              SiteStatus            @default(ACTIVE)
  address             String?
  city                String?
  state               String?
  country             String
  productionCapacity  Float?
  capacityUnit        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  calculatedEmissions CalculatedEmissions[]
  documents           Document[]
  emissionsAggregates EmissionsAggregate[]
  shipmentStops       ShipmentStop[]
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles            Vehicle[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("sites")
}

/// Fiscal & Calendar Reporting Periods
model ReportingPeriod {
  id                  String                @id @default(cuid())
  organizationId      String
  name                String
  startDate           DateTime
  endDate             DateTime
  status              ReportingPeriodStatus @default(OPEN)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  calculatedEmissions CalculatedEmissions[]
  documents           Document[]
  emissionsAggregates EmissionsAggregate[]
  brsrReports         BrsrReport[]
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("reporting_periods")
}

/// Controlled GHG Document Taxonomy Categories
model DocumentCategory {
  id                String     @id @default(cuid())
  code              String     @unique
  name              String
  scope             ScopeType
  description       String
  requiredByDefault Boolean    @default(false)
  acceptedMimeTypes String[]
  createdAt         DateTime   @default(now())
  documents         Document[]

  @@map("document_categories")
}

/// Uploaded Activity Document Entity
model Document {
  id                  String                  @id @default(cuid())
  organizationId      String
  siteId              String
  reportingPeriodId   String
  categoryId          String
  uploadedById        String
  fileName            String
  fileSize            Int
  mimeType            String
  s3Key               String
  source              DocumentSource          @default(UPLOAD)
  status              DocumentStatus          @default(UPLOADED)
  manualData          Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  calculatedEmissions CalculatedEmissions[]
  calculationLogs     CalculationLog[]
  statusHistory       DocumentStatusHistory[]
  category            DocumentCategory        @relation(fields: [categoryId], references: [id])
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod     ReportingPeriod         @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  site                Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  uploadedBy          User                    @relation(fields: [uploadedById], references: [id])
  extractedData       ExtractedData[]
  extractionJobs      ExtractionJob[]
  reviewActions       ReviewAction[]
  validationResults   ValidationResult[]
  fingerprint         DocumentFingerprint?

  @@index([organizationId, siteId, reportingPeriodId])
  @@index([status])
  @@map("documents")
}

/// Document Status State Machine Audit History
model DocumentStatusHistory {
  id          String          @id @default(cuid())
  documentId  String
  fromStatus  DocumentStatus?
  toStatus    DocumentStatus
  reason      String?
  changedById String?
  createdAt   DateTime        @default(now())
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_status_history")
}

/// Extracted Structured Data (Versioned with Optimistic Lock version)
model ExtractedData {
  id                  String              @id @default(cuid())
  documentId          String
  extractionVersion   Int                 @default(1)
  version             Int                 @default(1)
  fieldsJson          Json
  fieldConfidenceJson Json
  modelVersion        String              @default("tesseract-v5+langchain")
  status              ExtractionJobStatus @default(SUCCESS)
  createdAt           DateTime            @default(now())
  document            Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([extractionVersion])
  @@map("extracted_data")
}

/// AI Extraction Pipeline Jobs Tracking
model ExtractionJob {
  id           String              @id @default(cuid())
  documentId   String
  status       ExtractionJobStatus @default(PENDING)
  attemptCount Int                 @default(0)
  lastError    String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  document     Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("extraction_jobs")
}

/// Validation Rules Catalog
model ValidationRule {
  id          String          @id @default(cuid())
  ruleCode    String          @unique
  name        String
  description String
  layer       ValidationLayer
  configJson  Json?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@map("validation_rules")
}

/// Validation Results
model ValidationResult {
  id              String           @id @default(cuid())
  documentId      String
  layer           ValidationLayer
  status          ValidationStatus @default(PASS)
  issuesJson      Json
  explanationText String?
  createdAt       DateTime         @default(now())
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([layer])
  @@map("validation_results")
}

/// Human Review Audit Actions
model ReviewAction {
  id                 String           @id @default(cuid())
  documentId         String
  action             ReviewActionType
  performedById      String
  reason             String?
  previousValuesJson Json?
  createdAt          DateTime         @default(now())
  document           Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  performedBy        User             @relation(fields: [performedById], references: [id])

  @@index([documentId])
  @@index([performedById])
  @@map("review_actions")
}

/// Controlled Emission Factors Library (SUPER_ADMIN additive versioning)
model EmissionFactor {
  id                  String                @id @default(cuid())
  category            String
  subCategory         String
  region              String                @default("GLOBAL")
  factorValue         Float
  unit                String
  co2eUnit            String                @default("kgCO2e")
  sourceSet           String                @default("GLEC_2023")
  version             Int                   @default(1)
  effectiveFrom       DateTime              @default(now())
  effectiveTo         DateTime?
  createdBy           String                @default("SYSTEM")
  createdAt           DateTime              @default(now())
  calculatedEmissions CalculatedEmissions[]

  @@unique([category, subCategory, region, sourceSet, version])
  @@index([category, subCategory, region])
  @@map("emission_factors")
}

/// Unit Conversion Scaling Matrix
model UnitConversion {
  id               String   @id @default(cuid())
  fromUnit         String
  toUnit           String
  conversionFactor Float
  createdAt        DateTime @default(now())

  @@unique([fromUnit, toUnit])
  @@map("unit_conversions")
}

/// Deterministic Output: Calculated CO2e Emissions
model CalculatedEmissions {
  id                String           @id @default(cuid())
  organizationId    String
  siteId            String
  reportingPeriodId String
  documentId        String
  emissionFactorId  String
  scope             ScopeType
  co2e              Float
  co2eLocation      Float?
  co2eMarket        Float?
  co2               Float?
  ch4               Float?
  n2o               Float?
  activityValue     Float
  activityUnit      String
  calculationMethod String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  document          Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  emissionFactor    EmissionFactor   @relation(fields: [emissionFactorId], references: [id])
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod   ReportingPeriod  @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  site              Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  calculationLogs   CalculationLog[]
  routePlans        RoutePlan[]

  @@index([organizationId, siteId, reportingPeriodId])
  @@index([scope])
  @@map("calculated_emissions")
}

/// Immutable Formula & Input Audit Trail Log (PRD §7.11)
model CalculationLog {
  id                    String              @id @default(cuid())
  calculatedEmissionsId String
  documentId            String
  inputSnapshot         Json
  factorVersion         Int
  formulaVersion        String              @default("v1.0-GLEC-GHG")
  formulaUsed           String
  triggeredBy           String
  createdAt             DateTime            @default(now())
  calculatedEmissions   CalculatedEmissions @relation(fields: [calculatedEmissionsId], references: [id], onDelete: Cascade)
  document              Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([calculatedEmissionsId])
  @@index([documentId])
  @@map("calculation_logs")
}

/// Rollup Aggregates per Org, Site, and Reporting Period
model EmissionsAggregate {
  id                  String          @id @default(cuid())
  organizationId      String
  siteId              String
  reportingPeriodId   String
  scope1Total         Float           @default(0)
  scope2LocationTotal Float           @default(0)
  scope2MarketTotal   Float           @default(0)
  scope3Total         Float           @default(0)
  grandTotal          Float           @default(0)
  updatedAt           DateTime        @updatedAt
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod     ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  site                Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([organizationId, siteId, reportingPeriodId])
  @@map("emissions_aggregates")
}

/// AI Engine Usage & Cost Tracking Audit Log
model AiLog {
  id             String        @id @default(cuid())
  feature        AiFeature
  organizationId String?
  inputRef       String?
  promptText     String?
  responseText   String?
  tokensUsed     Int?
  latencyMs      Int?
  costEstimate   Float?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([feature])
  @@map("ai_logs")
}

/// Organization Preferences & Settings
model OrganizationSetting {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  unitSystem              String       @default("METRIC")
  currency                String       @default("USD")
  defaultFramework        String       @default("BRSR")
  reportingYearStartMonth Int          @default(1)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// Controlled Industry Catalog
model Industry {
  id                     String                  @id @default(cuid())
  code                   String                  @unique
  name                   String
  description            String?
  createdAt              DateTime                @default(now())
  emissionFactorMappings IndustryFactorMapping[]
  organizations          Organization[]

  @@map("industries")
}

/// Industry to Emission Factor Set Mappings
model IndustryFactorMapping {
  id                String   @id @default(cuid())
  industryId        String
  emissionFactorSet String
  scopeCategory     String?
  createdAt         DateTime @default(now())
  industry          Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@index([industryId])
  @@map("industry_factor_mappings")
}

/// Platform users.
model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  fullName          String
  role              UserRole       @default(ORG_MEMBER)
  status            UserStatus     @default(PENDING_VERIFICATION)
  organizationId    String?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  auditLogs         AuditLog[]
  authTokens        AuthToken[]
  documentsUploaded Document[]
  invitesCreated    Invite[]       @relation("InvitedByUser")
  notifications     Notification[]
  reviewActions     ReviewAction[]
  sessions          Session[]
  shipments         Shipment[]
  organization      Organization?  @relation(fields: [organizationId], references: [id])

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

/// Refresh token sessions.
model Session {
  id               String        @id @default(cuid())
  userId           String
  organizationId   String?
  refreshTokenHash String        @unique
  deviceInfo       String?
  ipAddress        String?
  expiresAt        DateTime
  isRevoked        Boolean       @default(false)
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  organization     Organization? @relation(fields: [organizationId], references: [id])
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

/// Verification and Reset Tokens
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("auth_tokens")
}

/// Organization Teammate Invites
model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  invitedById    String
  tokenHash      String       @unique
  role           UserRole     @default(ORG_MEMBER)
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  invitedBy      User         @relation("InvitedByUser", fields: [invitedById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@map("invites")
}

/// Named feature flags.
model FeatureFlag {
  id             String           @id @default(cuid())
  key            String           @unique
  description    String
  isEnabled      Boolean          @default(true)
  scope          FeatureFlagScope @default(GLOBAL)
  organizationId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id])

  @@index([key])
  @@index([organizationId])
  @@map("feature_flags")
}

/// Business-tunable config key/value store.
model ConfigEntry {
  id          String   @id @default(cuid())
  key         String   @unique
  valueJson   Json
  description String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("config_entries")
}

/// In-app notification record.
model Notification {
  id             String           @id @default(cuid())
  userId         String
  organizationId String?
  type           NotificationType
  message        String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId])
  @@map("notifications")
}

/// Platform-wide audit trail.
model AuditLog {
  id             String        @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  entityType     String?
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  reason         String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityTypeMapping {
  id                   String   @id @default(cuid())
  categoryCode         String   @unique
  emissionCategory     String
  subCategoryFieldName String?
  fallbackSubCategory  String
  strategyKey          String
  sourceCitation       String
  createdAt            DateTime @default(now())

  @@map("activity_type_mappings")
}

model CargoItem {
  id                                                       String          @id @default(cuid())
  organizationId                                           String
  shipmentId                                               String
  sku                                                      String?
  description                                              String
  packageType                                              String?
  quantity                                                 Int             @default(1)
  length                                                   Decimal         @db.Decimal(10, 2)
  width                                                    Decimal         @db.Decimal(10, 2)
  height                                                   Decimal         @db.Decimal(10, 2)
  dimensionUnit                                            DimensionUnit   @default(CM)
  unitWeight                                               Decimal         @db.Decimal(10, 3)
  totalWeight                                              Decimal         @db.Decimal(12, 3)
  weightUnit                                               WeightUnit      @default(KG)
  unitVolume                                               Decimal?        @db.Decimal(10, 4)
  totalVolume                                              Decimal?        @db.Decimal(12, 4)
  volumeUnit                                               VolumeUnit      @default(M3)
  isStackable                                              Boolean         @default(true)
  maxStackWeight                                           Decimal?        @db.Decimal(10, 2)
  maxStackTiers                                            Int?
  isFragile                                                Boolean         @default(false)
  allowRotationHorizontal                                  Boolean         @default(true)
  allowRotationVertical                                    Boolean         @default(false)
  allowedOrientations                                      String[]        @default(["DEFAULT"])
  loadingPriority                                          Int             @default(1)
  unloadingSequence                                        Int             @default(1)
  pickupStopId                                             String?
  dropoffStopId                                            String?
  createdAt                                                DateTime        @default(now())
  updatedAt                                                DateTime        @updatedAt
  dropoffStop  ShipmentStop? @relation("cargo_items_dropoffStopIdToshipment_stops", fields: [dropoffStopId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pickupStop   ShipmentStop? @relation("cargo_items_pickupStopIdToshipment_stops", fields: [pickupStopId], references: [id])
  shipment     Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([dropoffStopId])
  @@index([organizationId])
  @@index([pickupStopId])
  @@index([shipmentId])
  @@map("cargo_items")
}

model LoadPlan {
  id                   String            @id @default(cuid())
  optimizationRunId    String
  vehicleSequence      Int               @default(1)
  vehicleTypeId        String?
  vehicleId            String?
  loadedWeightKg       Decimal           @db.Decimal(12, 3)
  loadedVolumeM3       Decimal           @db.Decimal(12, 4)
  weightUtilizationPct Decimal           @db.Decimal(5, 2)
  volumeUtilizationPct Decimal           @db.Decimal(5, 2)
  centerOfGravityX     Decimal?          @db.Decimal(6, 2)
  centerOfGravityY     Decimal?          @db.Decimal(6, 2)
  centerOfGravityZ     Decimal?          @db.Decimal(6, 2)
  axleLoadFrontKg      Decimal?          @db.Decimal(10, 2)
  axleLoadRearKg       Decimal?          @db.Decimal(10, 2)
  placementsJson       Json
  createdAt            DateTime          @default(now())
  optimizationRun OptimizationRun @relation(fields: [optimizationRunId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])
  vehicleType     VehicleType?    @relation(fields: [vehicleTypeId], references: [id])
  routePlan       RoutePlan?

  @@index([optimizationRunId])
  @@index([vehicleId])
  @@index([vehicleTypeId])
  @@map("load_plans")
}

model OptimizationRun {
  id                          String             @id @default(cuid())
  organizationId              String
  shipmentId                  String
  scenarioName                String             @default("Scenario 1")
  runNumber                   Int                @default(1)
  status                      OptimizationStatus @default(PENDING)
  algorithmVersion            String             @default("v1-3d-binpack")
  parametersJson              Json?
  baselineTruckCount          Int?
  optimizedTruckCount         Int?
  baselineDistanceKm          Decimal?           @db.Decimal(10, 2)
  optimizedDistanceKm         Decimal?           @db.Decimal(10, 2)
  baselineDurationMins        Decimal?           @db.Decimal(10, 2)
  optimizedDurationMins       Decimal?           @db.Decimal(10, 2)
  totalLoadedWeightKg         Decimal?           @db.Decimal(12, 3)
  totalLoadedVolumeM3         Decimal?           @db.Decimal(12, 4)
  overallVolumeUtilizationPct Decimal?           @db.Decimal(5, 2)
  overallWeightUtilizationPct Decimal?           @db.Decimal(5, 2)
  unassignedItemsCount        Int?               @default(0)
  violationsCount             Int?               @default(0)
  violationsJson              Json?
  executionTimeMs             Int?
  errorMessage                String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  loadPlans    LoadPlan[]     
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment     Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([shipmentId, status])
  @@map("optimization_runs")
}

model RoutePlan {
  id                    String               @id @default(cuid())
  loadPlanId            String               @unique
  routingProvider       String?
  distanceKm            Decimal              @db.Decimal(10, 2)
  durationMinutes       Decimal              @db.Decimal(10, 2)
  encodedPolyline       String?
  routeGeometryJson     Json?
  tollRoadsIncluded     Boolean?             @default(false)
  fuelEstimateLiters    Decimal?             @db.Decimal(10, 2)
  calculatedEmissionsId String?
  createdAt             DateTime             @default(now())
  calculatedEmissions CalculatedEmissions? @relation(fields: [calculatedEmissionsId], references: [id])
  loadPlan            LoadPlan             @relation(fields: [loadPlanId], references: [id], onDelete: Cascade)

  @@index([calculatedEmissionsId])
  @@index([loadPlanId])
  @@map("route_plans")
}

model ShipmentStop {
  id                                                    String        @id @default(cuid())
  shipmentId                                            String
  stopSequence                                          Int
  stopType                                              StopType      @default(PICKUP)
  siteId                                                String?
  facilityName                                          String?
  addressLine1                                          String
  addressLine2                                          String?
  city                                                  String?
  state                                                 String?
  postalCode                                            String?
  country                                               String
  latitude                                              Decimal?      @db.Decimal(10, 7)
  longitude                                             Decimal?      @db.Decimal(10, 7)
  timeWindowStart                                       DateTime?
  timeWindowEnd                                         DateTime?
  actualArrival                                         DateTime?
  actualDeparture                                       DateTime?
  specialInstructions                                   String?
  createdAt                                             DateTime      @default(now())
  updatedAt                                             DateTime      @updatedAt
  dropoffItems CargoItem[] @relation("cargo_items_dropoffStopIdToshipment_stops")
  pickupItems  CargoItem[] @relation("cargo_items_pickupStopIdToshipment_stops")
  shipment     Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  site         Site?       @relation(fields: [siteId], references: [id])

  @@unique([shipmentId, stopSequence])
  @@index([shipmentId])
  @@index([siteId])
  @@map("shipment_stops")
}

model Shipment {
  id                  String              @id @default(cuid())
  organizationId      String
  shipmentNumber      String
  status              ShipmentStatus      @default(DRAFT)
  referenceNumber     String?
  description         String?
  totalWeight         Decimal             @default(0) @db.Decimal(12, 3)
  weightUnit          WeightUnit          @default(KG)
  totalVolume         Decimal             @default(0) @db.Decimal(12, 4)
  volumeUnit          VolumeUnit          @default(M3)
  totalItemsCount     Int                 @default(0)
  plannedPickupDate   DateTime?
  plannedDeliveryDate DateTime?
  actualPickupDate    DateTime?
  actualDeliveryDate  DateTime?
  metadata            Json?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  cargoItems        CargoItem[]
  optimizationRuns  OptimizationRun[]
  shipmentStops     ShipmentStop[]
  createdBy         User?             @relation(fields: [createdById], references: [id])
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId, status])
  @@index([plannedPickupDate])
  @@map("shipments")
}

model VehicleType {
  id                 String          @id @default(cuid())
  organizationId     String?
  name               String
  category           String?
  bodyType           VehicleBodyType
  fuelType           VehicleFuelType
  emissionStandard   String?
  internalLength     Decimal?        @db.Decimal(10, 2)
  internalWidth      Decimal?        @db.Decimal(10, 2)
  internalHeight     Decimal?        @db.Decimal(10, 2)
  dimensionUnit      DimensionUnit   @default(CM)
  doorWidth          Decimal?        @db.Decimal(10, 2)
  doorHeight         Decimal?        @db.Decimal(10, 2)
  maxPayload         Decimal         @db.Decimal(12, 3)
  grossVehicleWeight Decimal?        @db.Decimal(12, 3)
  tareWeight         Decimal?        @db.Decimal(12, 3)
  weightUnit         WeightUnit      @default(KG)
  volumetricCapacity Decimal?        @db.Decimal(12, 4)
  volumeUnit         VolumeUnit      @default(M3)
  axleCount          Int?
  axleConfiguration  String?
  maxAxleWeightFront Decimal?        @db.Decimal(10, 3)
  maxAxleWeightRear  Decimal?        @db.Decimal(10, 3)
  isRefrigerated     Boolean         @default(false)
  temperatureMin     Decimal?        @db.Decimal(5, 2)
  temperatureMax     Decimal?        @db.Decimal(5, 2)
  metadata           Json?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  externalHeight     Decimal?        @db.Decimal(10, 2)
  externalLength     Decimal?        @db.Decimal(10, 2)
  externalWidth      Decimal?        @db.Decimal(10, 2)
  make               String?
  model              String?
  notes              String?
  sourceName         String?
  sourceUrl          String?
  variant            String?
  verificationStatus String          @default("UNVERIFIED")
  verifiedAt         DateTime?
  sourceType         String?
  verifiedBy         String?
  loadPlans    LoadPlan[]
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]

  @@index([bodyType])
  @@index([fuelType])
  @@index([organizationId])
  @@map("vehicle_types")
}

model Vehicle {
  id                 String        @id @default(cuid())
  organizationId     String
  vehicleTypeId      String
  registrationNumber String
  fleetNumber        String?
  homeSiteId         String?
  status             String        @default("ACTIVE")
  yearOfManufacture  Int?
  currentOdometerKm  Decimal?      @db.Decimal(12, 2)
  notes              String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  loadPlans    LoadPlan[]
  homeSite     Site?         @relation(fields: [homeSiteId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleType  VehicleType   @relation(fields: [vehicleTypeId], references: [id])

  @@unique([organizationId, registrationNumber])
  @@index([organizationId, status])
  @@index([vehicleTypeId])
  @@map("vehicles")
}

// ── ML / Forecasting Models ──────────────────────────────────────────────────

model MlModel {
  id                String          @id @default(cuid())
  organizationId    String
  name              String          @default("Forecast Model")
  modelType         MlModelType     @default(BASELINE_TREND)
  status            MlModelStatus   @default(TRAINING)
  version           Int             @default(1)
  mapeScore         Float?
  rmseScore         Float?
  featureImportance Json?
  artifactPath      String?
  metadata          Json?
  trainedAt         DateTime?       @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  predictions       MlPrediction[]
  trainingRuns      MlTrainingRun[]

  @@index([organizationId])
  @@map("ml_models")
}

model MlPrediction {
  id                String    @id @default(cuid())
  organizationId    String
  modelId           String
  predictedMonth    DateTime
  predictedCo2e     Float
  confidenceScore   Float     @default(0)
  confidenceLabel   String    @default("MEDIUM")
  trendDirection    String    @default("FLAT")
  featureImportance Json?
  isSanityChecked   Boolean   @default(true)
  inputData         Json?
  outputData        Json?
  confidence        Float?
  createdAt         DateTime  @default(now())
  model             MlModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([modelId])
  @@map("ml_predictions")
}

model MlTrainingRun {
  id                String    @id @default(cuid())
  modelId           String
  organizationId    String
  status            String    @default("RUNNING")
  monthsUsed        Int       @default(0)
  trainingSamples   Int       @default(0)
  validationSamples Int       @default(0)
  mapeScore         Float?
  rmseScore         Float?
  promoted          Boolean   @default(false)
  durationMs        Int?
  errorMessage      String?
  metrics           Json?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  model             MlModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([organizationId])
  @@map("ml_training_runs")
}

// ── Copilot / Knowledge Base ─────────────────────────────────────────────────

model KbDocument {
  id               String    @id @default(cuid())
  organizationId   String?
  uploadedById     String?
  sourceDocumentId String?
  filename         String
  documentType     String    @default("GENERAL")
  mimeType         String    @default("application/pdf")
  checksum         String
  status           String    @default("UPLOADED")
  pageCount        Int?
  tokenCount       Int?
  errorMessage     String?
  title            String?
  content          String?
  embedding        Json?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  chunks           KbChunk[]

  @@index([organizationId])
  @@index([checksum])
  @@map("kb_documents")
}

model KbChunk {
  id             String     @id @default(cuid())
  documentId     String
  organizationId String?
  chunkIndex     Int
  chunkText      String
  tokenCount     Int        @default(0)
  pageNumber     Int?
  sectionTitle   String?
  createdAt      DateTime   @default(now())
  document       KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([organizationId])
  @@map("kb_chunks")
}

model CopilotSession {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  title          String           @default("New Sustainability Session")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       CopilotMessage[]

  @@index([organizationId, userId])
  @@map("copilot_sessions")
}

model CopilotMessage {
  id             String          @id @default(cuid())
  organizationId String
  userId         String?
  sessionId      String
  role           String
  content        String
  citations      Json?
  metadata       Json?
  createdAt      DateTime        @default(now())
  session        CopilotSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, sessionId])
  @@map("copilot_messages")
}

// ── Document Deduplication ───────────────────────────────────────────────────

model DocumentFingerprint {
  id             String    @id @default(cuid())
  organizationId String
  documentId     String?   @unique
  sha256Hash     String    @unique
  hash           String?
  algorithm      String    @default("sha256")
  invoiceNumber  String?
  supplierName   String?
  invoiceDate    DateTime?
  totalAmount    Float?
  quantity       Float?
  unit           String?
  createdAt      DateTime  @default(now())
  document       Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierName, invoiceNumber])
  @@map("document_fingerprints")
}

// ── Activity Records ─────────────────────────────────────────────────────────

model ActivityRecord {
  id                 String    @id @default(cuid())
  organizationId     String
  documentId         String?
  lineItemIndex      Int       @default(0)
  activityType       String
  scope              String    @default("SCOPE_2")
  quantity           Float     @default(0)
  unit               String    @default("UNITS")
  normalizedQuantity Float?
  normalizedUnit     String?
  supplier           String?
  confidence         Float     @default(1.0)
  provenanceJson     Json?
  rawData            Json?
  processedData      Json?
  status             String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId])
  @@index([documentId])
  @@map("activity_records")
}

// ── BRSR Reporting ───────────────────────────────────────────────────────────

model BrsrReport {
  id                String           @id @default(cuid())
  organizationId    String
  reportingPeriodId String?
  financialYear     String
  boundary          String           @default("STANDALONE")
  version           Int              @default(1)
  status            String           @default("DRAFT")
  completenessScore Float            @default(0)
  sectionAData      Json?
  sectionBData      Json?
  sectionCData      Json?
  environmentalData Json?
  carbonMetricsJson Json?
  isAssured          Boolean          @default(false)
  assuranceProvider  String?
  assuranceType      String?
  assuranceReportUrl String?
  createdById        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod   ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id])
  snapshots         BrsrSnapshot[]

  @@unique([organizationId, financialYear, version])
  @@index([organizationId])
  @@map("brsr_reports")
}

model BrsrSnapshot {
  id             String      @id @default(cuid())
  brsrReportId   String
  organizationId String
  version        Int         @default(1)
  financialYear  String
  snapshotData   Json
  pdfUrl         String?
  generatedById  String?
  generatedAt    DateTime    @default(now())
  createdAt      DateTime    @default(now())
  brsrReport     BrsrReport  @relation(fields: [brsrReportId], references: [id], onDelete: Cascade)

  @@index([brsrReportId])
  @@index([organizationId])
  @@map("brsr_snapshots")
}

