# =============================================================================
# Carbon OS — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# All variables here are validated at boot via src/config/env.schema.ts.
# A PR that introduces a new env var MUST update this file in the same commit.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Primary database connection (PostgreSQL with pgvector)
DATABASE_URL="postgresql://carbon_os:carbon_os_dev_password@localhost:5432/carbon_os_dev?schema=public"
MONGODB_URL="mongodb://carbon_os:carbon_os_dev_password@localhost:27017/carbon_os_dev?authSource=admin"

# Read replica for dashboard queries and ML feature vectors
DATABASE_URL_READONLY="postgresql://carbon_os:carbon_os_dev_password@localhost:5432/carbon_os_dev?schema=public"

# ── Redis (BullMQ + rate limiting) ───────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET_ACCESS
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET_REFRESH
# Access token lifetime (ms-compatible string, e.g. "15m", "1h")
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime (days as integer)
JWT_REFRESH_EXPIRES_DAYS=7

# ── Object Storage (MinIO in dev / AWS S3 in prod) ───────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=carbon-os-dev
S3_ACCESS_KEY=carbon_os_minio
S3_SECRET_KEY=carbon_os_minio_dev
S3_REGION=us-east-1
# Set to "true" to use path-style addressing (required for MinIO)
S3_FORCE_PATH_STYLE=true

# ── SMTP (transactional email) ────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Carbon OS <noreply@carbon-os.local>"

# ── LLM (OpenAI-compatible endpoint) ─────────────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=REPLACE_WITH_OPENAI_API_KEY
LLM_MODEL=gpt-4o

# ── Vector Store (pgvector on primary Postgres — no separate service) ─────────
# No separate CHROMA_URL needed: pgvector extension on DATABASE_URL instance.
# This var is kept as a placeholder per TRD; set to empty string in v1.
CHROMA_URL=

# ── ML Service (Python FastAPI, internal only) ────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── OCR Provider ─────────────────────────────────────────────────────────────
# "tesseract" (default, self-hosted) | "cloud" (external API, configure below)
OCR_PROVIDER=tesseract

# ── Observability ─────────────────────────────────────────────────────────────
# OTLP endpoint for OpenTelemetry traces (leave empty to disable tracing in dev)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Used by apps/web (shipmind-ai). Not read by core-api.
VITE_API_URL=http://localhost:3000
